# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/gl-horses

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLATFORM_FEE_PERCENT=2.5

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@glhorses.com

# Twilio Verify (for 2FA SMS verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# Legacy payment gateway (no longer used)
# WINDCAVE_API_URL=...
# WINDCAVE_API_USER=...
# WINDCAVE_API_KEY=...
# WINDCAVE_WEBHOOK_SECRET=...

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Google Cloud Storage (for document uploads)
# Leave empty to use local storage as fallback
GCS_PROJECT_ID=your_gcs_project_id
GCS_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GCS_BUCKET_NAME=your_bucket_name

# Google Calendar (for demo scheduling)
# Uses the same GCS_CLIENT_EMAIL and GCS_PRIVATE_KEY from above
# The service account needs Calendar API enabled and calendar access
GOOGLE_CALENDAR_ID=primary

# Frontend URL (for CORS and emails)
CLIENT_URL=http://localhost:5173

# QuickBooks/Intuit API
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:5001/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
